# Configurar en la copia temporal con tus propios contactos y credenciales.
# Inicio y fin incluidos. Para un solo día, usa la misma fecha en ambos.
TEST_START_DATE=2026-10-09
TEST_END_DATE=2026-10-09
# Mantener true hasta revisar destinos y previsualizaciones.
DRY_RUN=true
TEST_OWN_CONTACTS_CONFIRMED=false
SMS_ENABLED=false

# Únicamente medios propios del usuario; E.164, por ejemplo +57 y 10 dígitos.
# TEST_WHATSAPP vacío usa TEST_PHONE.
TEST_PHONE=
TEST_WHATSAPP=
TEST_EMAIL=

TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
TWILIO_TRIAL_MODE=false
WHATSAPP_ENABLED=true
# Sin prefijo whatsapp:; sender registrado y ONLINE en Twilio.
WHATSAPP_SENDER=
# Plantilla aprobada, con variables 1=fecha, 2=capital, 3=interés, 4=total.
WHATSAPP_CONTENT_SID=

GMAIL_USER=
GMAIL_APP_PASSWORD=

# Parámetros financieros reutilizados de la v5; sin historial ni destinatarios.
BALANCE_ANCHOR_DATE=2026-09-15
BALANCE_ANCHOR_PRINCIPAL_COP=268019128.13
MONTHLY_RATE=0.05
DAYS_IN_MONTH_BASIS=30
CAPITALIZATION_DAY=15
